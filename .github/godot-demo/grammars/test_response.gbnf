# Grammar for structured test responses
# This ensures the model outputs a valid JSON object with our expected fields

root ::= test_response

test_response ::= "{" ws 
  "\"answer\":" ws string "," ws
  "\"explanation\":" ws string "," ws
  "\"confidence\":" ws number
"}" ws

string ::=
  "\"" (
    [^"\\] |
    "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4})
  )* "\""

number ::= [0-9]+ ("." [0-9]+)?

# Optional whitespace
ws ::= [ \t\n]*
